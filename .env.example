# ================================================
# TotalMix OSC Bridge Environment Variables
# Copy to .env and edit as needed
# ================================================

# RME UFX II OSC (TotalMix)
OSC_IP=192.168.1.50
OSC_PORT=9001

# MQTT (Mosquitto)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=your_mqtt_user
MQTT_PASS=your_mqtt_password

# Web Client v1 (FastAPI UI)
WEB_PORT=8088          # ← CHANGE THIS IF NEEDED (single source of truth)

# OSC listener — structured TotalMix feedback (device state + channel-map
# discovery). Point TotalMix's OSC "Port outgoing" at this server on this
# port. On by default. The legacy log-only monitor below must be OFF (or on
# a different port) when the listener is enabled.
ENABLE_OSC_LISTENER=true
OSC_LISTEN_PORT=9001

# Legacy log-only OSC monitor (superseded by the listener above)
ENABLE_OSC_MONITOR=false